# GitNest startup configuration.
#
# Install this as /etc/gitnest/gitnest.env, owned by the service account, mode 0640:
#
#   install -o root -g gitnest -m 0640 deploy/gitnest.env.example /etc/gitnest/gitnest.env
#
# **This file is read by every unit and must never be committed with real values.**
# It contains no secret here and must contain none in the repository. The database
# credentials below are placeholders.
#
# Everything in this file is startup configuration. Instance policy — registration
# mode, default visibility, quotas, SMTP, the search backend, workspace limits — lives
# in the instance settings table and is changed through the operator console without a
# restart. A setting belongs to exactly one of the two, and an upgrade never migrates a
# setting from one layer to the other silently.

# The canonical absolute URL users reach this instance at. Required, and it must be
# the URL a browser sees: the OAuth callbacks, the LFS action URLs, and the links in
# email are all built from it. A reverse proxy setting forwarded headers does not
# change it.
GITNEST_PUBLIC_URL=https://gitnest.example.com

# The database. Use a dedicated role with CONNECT on this database and nothing else;
# the migration runner needs DDL rights on the schema it owns, so grant ownership of
# the schema rather than superuser.
GITNEST_DATABASE_URL=postgres://gitnest:CHANGE_ME@localhost:5432/gitnest?sslmode=require

# Where the instance keeps its data: the repository root, the temporary Git operation
# space, and the local blob storage. It must be on storage sized for repository growth
# and backed up with the database as one recovery set.
GITNEST_DATA_DIR=/var/lib/gitnest

# Where the bare Git repositories live. It defaults to <data dir>/repositories, and it
# is worth setting explicitly only when the repositories belong on separate storage
# from the rest of the data directory — a different volume, or a filesystem better
# suited to many small reads. Changing it on an existing instance moves nothing: the
# bytes stay where they are and the instance stops finding them, so a move is a
# documented storage migration rather than a configuration change.
GITNEST_REPO_ROOT=/var/lib/gitnest/repositories

# The scratch space for Git operations, which is swept at startup and must be on the
# same filesystem as the repository root, because a rename across filesystems is not
# possible and the operation would fall back to a copy.
GITNEST_TMP_ROOT=/var/lib/gitnest/tmp

# The HTTP listener. Bind to loopback when a reverse proxy terminates TLS on the same
# host, which is the documented deployment; bind to 0.0.0.0 only when the listener is
# reachable by something that enforces TLS itself.
GITNEST_HOST=127.0.0.1
GITNEST_PORT=8080

# The SSH listener, for `gitnest ssh`.
GITNEST_SSH_LISTEN=0.0.0.0:2222

# Log verbosity: debug, info, warn, or error. Logs go to standard output as structured
# lines, so the platform's collector handles retention.
GITNEST_LOG_LEVEL=info

# How long a delivered signal may take to drain in-flight requests and Git operations.
GITNEST_SHUTDOWN_TIMEOUT=30s

# How long a request's headers may take to arrive before the connection is dropped.
# It is the first line of defence against a slow-header client.
GITNEST_READ_HEADER_TIMEOUT=10s

# The connection-pool budget. The web process gets a larger pool than the worker,
# which is why these are configuration rather than constants.
GITNEST_DB_MAX_OPEN_CONNS=20
GITNEST_DB_MAX_IDLE_CONNS=5
GITNEST_DB_CONN_MAX_LIFETIME=30m
GITNEST_DB_CONN_MAX_IDLE_TIME=5m
GITNEST_DB_ACQUIRE_TIMEOUT=2s